{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winlrt.com.tr/schemas/lerta-mail-v1.json",
  "title": "LertaMailWebhookPayload",
  "type": "object",
  "required": [
    "contract_version",
    "product",
    "tier",
    "filename",
    "size_bytes",
    "sha256_hex",
    "mime",
    "within_limit",
    "kvkk_local_only",
    "content_stays_on_device"
  ],
  "properties": {
    "contract_version": { "type": "string", "const": "1" },
    "product": { "type": "string", "const": "winlrtZIP" },
    "tier": { "enum": ["standard10_mb", "extended25_mb"] },
    "filename": { "type": "string" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "mime": { "type": "string", "const": "application/zip" },
    "within_limit": { "type": "boolean" },
    "kvkk_local_only": { "type": "boolean" },
    "content_stays_on_device": { "type": "boolean" }
  },
  "additionalProperties": false
}
