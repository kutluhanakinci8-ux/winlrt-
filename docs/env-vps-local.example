# Mac/agent: cp docs/env-vps-local.example .env.vps.local  (gitignore — repoya gitmez)
VPS_HOST=37.230.105.99
VPS_PORT=23422
VPS_USER=root
VPS_WEB_ROOT=/var/www/winlrt/apps/web/dist
VPS_SSH_PASSWORD=

# (Opsiyonel) Dev PFX şifresi — yerelde decrypt / imza test; GitHub secret agent 403 ise panelden LERTIVA_DEV_CODESIGN_PASSWORD
# LERTIVA_DEV_CODESIGN_PASSWORD=

# Canlı vitrin erken erişim (nginx basic auth — yalnızca winlrt.com.tr)
# Yerel build / public/ geliştirme etkilenmez. Şifre repoya gitmez.
VITRIN_BASIC_AUTH_USER=lertiva
VITRIN_BASIC_AUTH_PASSWORD=
# Kapatmak için: VITRIN_BASIC_AUTH_DISABLE=1 bash scripts/vps-sync-vitrin-basic-auth.sh
