{
  "name": "lertiva",
  "version": "0.1.0",
  "private": true,
  "description": "Lertiva — Lertiva Arc / Lertiva Zip (Pack) arşiv platformu",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @lertiva/web",
    "build:web": "npm run build -w @lertiva/web",
    "dev:arc": "npm run tauri dev -w @lertiva/arc",
    "build:arc": "npm run tauri build -w @lertiva/arc",
    "dev:zip": "npm run tauri dev -w @lertiva/zip",
    "build:zip": "npm run tauri build -w @lertiva/zip"
  },
  "engines": {
    "node": ">=20"
  }
}
