Windows Registry Editor Version 5.00

; winlrtRAR kurumsal pilot — GPO Preferences ile dağıtılabilir.
; HKLM: makine geneli; HKCU: kullanıcı (uygulama HKCU önce okur).

[HKEY_LOCAL_MACHINE\Software\winlrt\winlrtRAR]
"PasswordPolicy"="corporate"
"AuditMirrorPath"="\\\\FILESERVER\\share\\winlrt-audit\\audit.jsonl"
"AuditForwardUrl"=""
