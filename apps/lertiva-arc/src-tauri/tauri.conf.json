{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lertiva Arc",
  "version": "1.0.2",
  "identifier": "com.lertiva.rar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lertiva Arc",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Lertiva Arc — yerli arşiv ve geçiş",
    "fileAssociations": [
      {
        "ext": ["zip"],
        "name": "ZIP arşivi",
        "description": "ZIP arşiv dosyası"
      },
      {
        "ext": ["wlrt"],
        "name": "Lertiva .wlrt arşivi",
        "description": "Lertiva .wlrt arşivi"
      },
      {
        "ext": ["rar"],
        "name": "RAR arşivi",
        "description": "RAR arşiv dosyası"
      },
      {
        "ext": ["7z"],
        "name": "7z arşivi",
        "description": "7-Zip arşiv dosyası"
      }
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": ["Turkish", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
