{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "winlrtRAR",
  "version": "0.1.0",
  "identifier": "com.winlrt.rar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "winlrtRAR",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "winlrt yerli arşiv — winlrtRAR",
    "fileAssociations": [
      {
        "ext": ["zip"],
        "name": "ZIP arşivi",
        "description": "ZIP arşiv dosyası"
      },
      {
        "ext": ["wlrt"],
        "name": "winlrt arşivi",
        "description": "winlrt .wlrt arşivi"
      },
      {
        "ext": ["rar"],
        "name": "RAR arşivi",
        "description": "RAR arşiv dosyası"
      },
      {
        "ext": ["7z"],
        "name": "7z arşivi",
        "description": "7-Zip arşiv dosyası"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": ["Turkish", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
